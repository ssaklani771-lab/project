      "cell_type": "code",
      "source": [
        "import cv2\n",
        "from collections import deque\n",
        "import numpy as np\n",
        "\n",
        "face_cascade = cv2.CascadeClassifier(\n",
        "    cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'\n",
        ")\n",
        "\n",
        "eye_cascade = cv2.CascadeClassifier(\n",
        "    cv2.data.haarcascades + 'haarcascade_eye.xml'\n",
        ")\n",
        "\n",
        "# Temporal buffer\n",
        "eye_seq = deque(maxlen=30)\n",
        "\n",
        "cap = cv2.VideoCapture(0)\n",
        "\n",
        "print(\"🚗 Final Project Running... Press Q to exit\")\n",
        "\n",
        "while True:\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
        "    faces = face_cascade.detectMultiScale(gray, 1.3, 5)\n",
        "\n",
        "    eye_open = 0\n",
        "\n",
        "    for (x, y, w, h) in faces:\n",
        "        face = gray[y:y+h, x:x+w]\n",
        "        eyes = eye_cascade.detectMultiScale(face)\n",
        "\n",
        "        for (ex, ey, ew, eh) in eyes:\n",
        "            eye_open = 1\n",
        "            cv2.rectangle(frame,\n",
        "                          (x+ex, y+ey),\n",
        "                          (x+ex+ew, y+ey+eh),\n",
        "                          (0,255,0), 2)\n",
        "\n",
        "    eye_seq.append(eye_open)\n",
        "\n",
        "    # Temporal fatigue score\n",
        "    fatigue_score = 1 - (sum(eye_seq)/len(eye_seq))\n",
        "\n",
        "    # Display score\n",
        "    cv2.putText(frame, f\"Fatigue Score: {fatigue_score:.2f}\",\n",
        "                (50, 100),\n",
        "                cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255,255,0), 2)\n",
        "\n",
        "    # Alert logic\n",
        "    if fatigue_score > 0.6:\n",
        "        cv2.putText(frame, \"DROWSY ⚠️\",\n",
        "                    (50, 50),\n",
        "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                    1.2, (0,0,255), 3)\n",
        "    else:\n",
        "        cv2.putText(frame, \"ALERT ✅\",\n",
        "                    (50, 50),\n",
        "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                    1.2, (0,255,0), 3)\n",
        "\n",
        "    cv2.imshow(\"Driver Monitoring System\", frame)\n",
        "\n",
        "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
        "        break\n",
        "\n",
        "cap.release()\n",
        "cv2.destroyAllWindows()"
      ],
