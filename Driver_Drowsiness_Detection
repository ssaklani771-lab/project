        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from sklearn.metrics import roc_curve, auc\n",
        "\n",
        "# Simulated training (replace with real dataset)\n",
        "epochs = 30\n",
        "\n",
        "loss = np.exp(-np.linspace(0, 3, epochs)) + np.random.rand(epochs)*0.05\n",
        "accuracy = 0.5 + (np.linspace(0, 1, epochs)*0.4) + np.random.rand(epochs)*0.05\n",
        "\n",
        "# -------------------------------\n",
        "# Plot Training Graph\n",
        "# -------------------------------\n",
        "plt.figure()\n",
        "plt.plot(loss, label=\"Loss\")\n",
        "plt.plot(accuracy, label=\"Accuracy\")\n",
        "plt.title(\"Training Performance (Temporal Model)\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Value\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------\n",
        "# ROC Curve\n",
        "# -------------------------------\n",
        "y_true = np.random.randint(0, 2, 100)\n",
        "y_scores = np.random.rand(100)\n",
        "\n",
        "fpr, tpr, _ = roc_curve(y_true, y_scores)\n",
        "roc_auc = auc(fpr, tpr)\n",
        "\n",
        "plt.figure()\n",
        "plt.plot(fpr, tpr, label=f\"AUC = {roc_auc:.2f}\")\n",
        "plt.plot([0,1],[0,1],'--')\n",
        "plt.title(\"ROC Curve\")\n",
        "plt.xlabel(\"FPR\")\n",
        "plt.ylabel(\"TPR\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()"
